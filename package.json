{
  "name": "homyvest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "assets:padel": "node scripts/clean-padel.mjs",
    "assets:images": "node scripts/optimize-images.mjs",
    "assets": "npm run assets:padel && npm run assets:images",
    "e2e": "playwright test --project=desktop --project=mobile",
    "shots": "playwright test --project=shots",
    "assets:brand": "node scripts/make-brand-assets.mjs",
    "assets:depth": ".venv-depth\\Scripts\\python.exe scripts/depth-maps.py",
    "assets:logos": "node scripts/make-logos.mjs",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "gdrive:auth": "node scripts/gdrive-auth.mjs",
    "supabase:deploy": "supabase db push && supabase functions deploy generate-report --no-verify-jwt"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@supabase/supabase-js": "^2.119.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "maath": "^0.10.8",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "pdf-lib": "1.17.1",
    "sharp": "^0.35.5",
    "supabase": "^3.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
