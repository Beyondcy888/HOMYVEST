{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "npm:pdf-lib@1.17.1": [
        "./node_modules/pdf-lib"
      ]
    }
  },
  "include": [
    "src",
    "qa",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "supabase/functions"
  ]
}
